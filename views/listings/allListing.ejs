    <div class="tax-switch">
        <div class="form-check-reverse form-switch">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
        </div>
    </div>
</div>

    <!-- <form method="get" action="/listings/new" class="create">
        <button id="createButton">Create New Listing</button>
    </form> -->

    <div id="mainIndex">
        <% for (listing of lstng ) { %>
            <a href="/listings/<%= listing._id %>" class="aaa">
                <div class="indexDT">
                    <img class="imgg" src="<%= listing.image.url %>"/>
                    <h2 class="title"> <%= listing.title %> </h2>
                    <h2 class="price comon"> <span>Price : </span> &#8377; <%= listing.price.toLocaleString("en-IN") %> /day </h2>
                    <i class="text-info"> +18% GST </i>
                </div>
            </a>
        <% } %>
    </div>
</body>

